# Firecrawl self-hosted environment variables
#
# Required:
PORT=3002
HOST=0.0.0.0

# Redis (internal to Firecrawl stack)
REDIS_URL=redis://firecrawl_redis:6379
REDIS_RATE_LIMIT_URL=redis://firecrawl_redis:6379

# Playwright microservice (internal URL)
PLAYWRIGHT_MICROSERVICE_URL=http://firecrawl_playwright:3000/scrape

# Bull Queue admin auth — change this if the instance is publicly accessible
BULL_AUTH_KEY=firecrawl-admin-key

# PostgreSQL (nuq-postgres for job persistence / NUQ queue)
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=changeme-firecrawl-pg
POSTGRES_DB=firecrawl
POSTGRES_HOST=firecrawl_postgres
POSTGRES_PORT=5432
USE_DB_AUTHENTICATION=false

# Concurrency tuning
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3

# --- Optional: AI features (JSON extraction on scrape) ---
# Provide your OpenAI API key (or any OpenAI-compatible endpoint) to enable
# AI-powered structured extraction via the /extract API.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://...
# MODEL_NAME=gpt-4o-mini
# MODEL_EMBEDDING_NAME=text-embedding-3-small

# --- Optional: Ollama (self-hosted LLM) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
# MODEL_NAME=llama3.2

# --- Optional: Proxy ---
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# --- Optional: /search API (SearXNG instead of Google) ---
# SEARXNG_ENDPOINT=http://searxng:8080
# SEARXNG_ENGINES=
# SEARXNG_CATEGORIES=

# --- Optional: Logging ---
# LOGGING_LEVEL=info

# --- Optional: Local webhooks ---
# ALLOW_LOCAL_WEBHOOKS=true
